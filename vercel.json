{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/he", "destination": "/index.html" },
    { "source": "/en", "destination": "/index.html" },
    { "source": "/fr", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
